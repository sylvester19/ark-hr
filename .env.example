# Copy to .env. Do not commit .env. Never put a client secret in git.

# local = this PC, Microsoft sign-in optional, files on disk.
# prod  = Group Arkays Azure. Refuses to start unless storage, region,
#         Microsoft sign-in, and a private model host are set.
ARK_HR_ENV=local

# 1 = Day 1. 2 = Day 1 plus OCR, job-match, retention screen, email, audit screen.
ARK_HR_PHASE=1

ARK_HR_PUBLIC_URL=http://localhost:3215
ARK_HR_API_URL=http://localhost:3000
ARK_HR_SECRET=change-me-to-a-long-random-string

# Copied from ARK IMPEX core (apps/api/.env). Same app registration and the
# same redirect. ARK HR must be the process listening on port 3000.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
AZURE_REDIRECT_URI=http://localhost:3000/auth/callback
JWT_SECRET=
ARK_HR_USERS_GROUP=ARK-HR-Users
ARK_HR_ADMINS_GROUP=ARK-HR-Admins
# Comma-separated. Used only when the Microsoft token has no groups claim,
# which is how ARK IMPEX core signs in today.
ARK_HR_ADMIN_EMAILS=

# local only. Ignored when ARK_HR_ENV=prod.
ARK_HR_LOCAL_EMAIL=hr@grouparkays.com
ARK_HR_LOCAL_NAME=HR user
ARK_HR_LOCAL_ROLE=hr

# Blank uses the local Qwen2.5 1.5B GGUF in data/models (same prompt and JSON schema as Ollama).
# Set a tag such as qwen2.5:7b only when a private Ollama is running. No paid API is ever called.
ARK_HR_MODEL=
ARK_HR_GGUF=
ARK_HR_GROQ_API_KEY=
ARK_HR_GROQ_MODELS=
ARK_HR_AI_BASE_URL=http://127.0.0.1:11434
# Comma-separated extra hostnames allowed to receive CV text. Local and private IPs are already allowed.
ARK_HR_AI_HOST_ALLOWLIST=

# Prod requires Azure Blob in UAE North. Local uses the data/ folder.
ARK_HR_STORAGE=local
ARK_HR_AZURE_CONNECTION_STRING=
ARK_HR_AZURE_CONTAINER=ark-hr-cvs
ARK_HR_AZURE_REGION=uaenorth

# Phase 2 email. Microsoft Graph sendMail from an existing portal mailbox.
ARK_HR_GRAPH_SENDER=
ARK_HR_DATA_DIR=
